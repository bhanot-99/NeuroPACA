# --- NeuroPACA ---
# Runtime data — graph, idle cache, action log, logs (Architecture.md §15).
# The daemon owns this directory; only the placeholder and the shipped default
# rules files are tracked.
/data/*
!/data/.gitkeep
!/data/app_map.default.toml
*.log

# Model weights and llama.cpp build artifacts (B0 spike)
/models/
*.gguf
/spikes/**/llama.cpp/

# Spike run artifacts — timestamped, machine-specific. The canonical result that
# backs a paper claim is committed deliberately with `git add -f`.
/spikes/b0_bitnet/results/*
!/spikes/b0_bitnet/results/.gitkeep

# Generated perf/soak fixtures — ~4 MB, regenerate deterministically from
# tests/fixtures/generate_10k_graph.py
/tests/fixtures/*.json
# ...but the tiny B3 recorded-telemetry traces ARE committed — they're the
# "recorded fixture" the B3 exit criterion asks for (generate_b3_traces.py).
!/tests/fixtures/trace_*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp

# Obsidian vault internals (kept out of the code repo)
/.obsidian/
/.trash/

# Personal project walkthrough — not a code-repo artifact
/neuropaca-field-guide.html

# B9 soak state — machine-local measurement, regenerated per run. The result
# that matters is the summary quoted in phases.md, not 10 080 sample rows.
data/b9_soak/
